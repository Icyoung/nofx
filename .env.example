# NOFX Environment Variables Template
# Copy this file to .env and modify the values as needed

# Ports Configuration
# Backend API server port (internal: 8080, external: configurable)
NOFX_BACKEND_PORT=8080

# Frontend web interface port (Nginx listens on port 80 internally)
NOFX_FRONTEND_PORT=3000

# Timezone Setting
# System timezone for container time synchronization
NOFX_TIMEZONE=Asia/Shanghai

# ===========================================
# 加密密鑰配置（必須設置）
# ===========================================

# 主密鑰 (AES-256) - 用於數據庫加密 (base64 編碼 32 字節)
# 生成方法: openssl rand -base64 32
# ⚠️ 警告：丟失此密鑰將導致所有加密數據無法恢復！
NOFX_MASTER_KEY=

# RSA 私鑰 (PEM 路徑)
# 生成方法:
#   mkdir -p secrets
#   openssl genrsa -out secrets/rsa_private.pem 4096
NOFX_RSA_PRIVATE_KEY_PATH=secrets/rsa_private.pem

# RSA 公鑰 (PEM 路徑)
# 生成方法:
#   openssl rsa -in secrets/rsa_private.pem -pubout -out secrets/rsa_public.pem
NOFX_RSA_PUBLIC_KEY_PATH=secrets/rsa_public.pem

# 本地密鑰目錄（Docker Compose 會把該目錄掛載到 /app/secrets）
NOFX_SECRETS_DIR=./secrets
